# ---------- Application Settings ---------
APP_NAME=aastrika-WFS-ETL
APP_VERSION=0.1.0
DEBUG=False
LOG_LEVEL=INFO

# ---------- Elasticsearch Settings ----------
ES_HOST=
ES_PORT=9200
ES_SCHEME=http
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PATTERN=betalaunch-telemetry-*
ES_TIMEOUT=30
ES_MAX_RETRIES=3

# ---------- PostgreSQL Settings ---------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_TABLE=telemetry_test

# ---------- ETL Pipeline Settings ----------
BATCH_SIZE=1000
DB_BATCH_SIZE=500
MAX_WORKERS=4
RETRY_ATTEMPTS=3
RETRY_DELAY=5
HOURS_WINDOW=24
FETCH_START_DATE=18-01-2026
ES_INDEX=betalaunch-telemetry-2026-01-18
ES_INDEX_PATTERN_SET=true

# ---------- Logging Settings ----------
LOG_TO_FILE=true
LOG_DIR=/app/logs
LOG_FILE_NAME=telemetry_etl.log
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=30
LOG_LEVEL=INFO

# ---------- AWS SES Email Settings ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_SENDER_EMAIL=
SES_RECIPIENT_EMAIL=user1@example.com,user2@example.com
