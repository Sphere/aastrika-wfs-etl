# Application Settings
APP_NAME=aastrika-telemetry
APP_VERSION=0.1.0
DEBUG=False
LOG_LEVEL=INFO

# Elasticsearch Settings
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=
ES_INDEX_PATTERN=
ES_TIMEOUT=30
ES_MAX_RETRIES=3
EX_INDEX_PATTERN_SET=false

# PostgreSQL Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telemetry_test
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_TABLE=telemetry_summary

# ETL Pipeline Settings
BATCH_SIZE=1000
MAX_WORKERS=4
RETRY_ATTEMPTS=3
RETRY_DELAY=5
HOURS_WINDOW=24
FETCH_START_DATE
